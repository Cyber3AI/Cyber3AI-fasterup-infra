<!-- Local rules - FasterUp AI Autonomous -->
<group name="suricata">
  <!-- Ridica nivel Suricata la 7 + compliance generic IDS -->
  <rule id="100200" level="7" overwrite="yes">
    <if_sid>86601</if_sid>
    <description>Suricata Alert — FasterUp IDS</description>
    <group>ids,gdpr_IV_35.7.d,nist_800_53_SI.4,pci_dss_11.4,tsc_CC7.2,</group>
  </rule>
  <!-- FALSE POSITIVE-URI — suprimate pe TOTI senzorii -->
  <rule id="100201" level="0">
    <if_sid>100200</if_sid>
    <field name="alert.signature">SURICATA Ethertype unknown</field>
    <description>False positive — ignorat</description>
  </rule>
  <rule id="100202" level="0">
    <if_sid>100200</if_sid>
    <field name="alert.signature">ET INFO Microsoft Connection Test</field>
    <description>False positive — Microsoft test ignorat</description>
  </rule>
  <rule id="100203" level="0">
    <if_sid>100200</if_sid>
    <field name="alert.signature">ET INFO Spotify P2P</field>
    <description>False positive — Spotify ignorat</description>
  </rule>
  <!-- Suprima promiscuous mode — normal pentru bridge senzor -->
  <rule id="100204" level="0">
    <if_sid>5104</if_sid>
    <field name="predecoder.hostname">rol-network</field>
    <description>False positive — bridge promiscuous mode ignorat</description>
  </rule>
  <rule id="100205" level="0">
    <if_sid>5104</if_sid>
    <field name="predecoder.hostname">icisoc101</field>
    <description>False positive — bridge promiscuous mode ignorat (icisoc101)</description>
  </rule>
  <!-- Whitelist infra — suprima AR pentru srcip in lista vitala -->
  <rule id="100210" level="0">
    <if_sid>5712</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/whitelist-infra</list>
    <description>Whitelist infra — suprima AR pentru srcip in lista vitala</description>
  </rule>
  <!-- P2 — Suprima zgomot benign Suricata (apt updates, telemetry, etc) -->
  <rule id="100211" level="1">
    <if_sid>100200</if_sid>
    <field name="alert.category">Not Suspicious Traffic</field>
    <description>Suricata: trafic benign — suprimat</description>
  </rule>
  <rule id="100212" level="1">
    <if_sid>100200</if_sid>
    <field name="alert.category">Generic Protocol Command Decode</field>
    <description>Suricata: protocol decode error — suprimat</description>
  </rule>
  <!-- P2 — Threat hunting (Misc activity) -->
  <rule id="100213" level="2">
    <if_sid>100200</if_sid>
    <field name="alert.category">Misc activity</field>
    <description>Suricata: threat hunting — Misc activity (catch-all benign - doar hunting/log)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>ids,threat_hunting,gdpr_IV_35.7.d,nist_800_53_SI.4,nist_800_53_AU.14,pci_dss_11.4,tsc_CC7.2,</group>
  </rule>
  <!-- P2 — Atacuri reale (proactiv definite, vor matchui cand apar) -->
  <rule id="100214" level="1">
    <if_sid>100200</if_sid>
    <field name="alert.category">Potential Corporate Privacy Violation</field>
    <description>Suricata: policy/privacy (P2P, remote-access) - suprimat</description>
  </rule>
  <rule id="100215" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.category">Web Application Attack</field>
    <description>Suricata: Web Application Attack detectat</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>ids,attack,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_SI.4,nist_800_53_SI.10,nist_800_53_SC.7,pci_dss_11.4,pci_dss_6.5.1,pci_dss_6.5.7,tsc_CC6.1,tsc_CC7.2,</group>
  </rule>
  <rule id="100216" level="12">
    <if_sid>100200</if_sid>
    <field name="alert.category">A Network Trojan was detected</field>
    <description>Suricata: Network Trojan / malware C2 detectat</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>ids,malware,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_SI.3,nist_800_53_SI.4,nist_800_53_SC.7,pci_dss_11.4,pci_dss_5.1,pci_dss_5.3,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,</group>
  </rule>
  <rule id="100217" level="12">
    <if_sid>100200</if_sid>
    <field name="alert.category">Attempted Administrator Privilege Gain</field>
    <description>Suricata: Privilege escalation attempt detectat</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>ids,privilege_escalation,gdpr_IV_35.7.d,gdpr_IV_32.2,nist_800_53_SI.4,nist_800_53_AC.6,pci_dss_11.4,pci_dss_7.1,tsc_CC6.1,tsc_CC6.3,tsc_CC7.2,</group>
  </rule>
  <!-- P2 — Suricata anomaly events (decode/stream/applayer) — vizibil in raport, sub pragul AR/CyberBot -->
  <rule id="100220" level="6">
    <if_sid>86600</if_sid>
    <field name="event_type">anomaly</field>
    <description>Suricata: anomaly event ($(anomaly.type)) — $(anomaly.event)</description>
    <group>ids,anomaly,gdpr_IV_35.7.d,nist_800_53_SI.4,pci_dss_11.4,tsc_CC7.2,</group>
  </rule>
</group>
