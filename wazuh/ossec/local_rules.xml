<group name="misp,threat_intel,">
  <!-- MISP IOC match — ALERT-ONLY level 9 (sub pragul AR=10, fara auto-block). Lista etc/lists/misp-ip, refresh zilnic din MISP. -->
  <rule id="100230" level="9">
    <if_sid>100200</if_sid>
    <list field="data.dest_ip" lookup="address_match_key">etc/lists/misp-ip</list>
    <description>MISP IOC: trafic catre IP din threat-intel ($(data.dest_ip))</description>
    <group>ids,</group>
  </rule>
  <rule id="100231" level="9">
    <if_sid>100200</if_sid>
    <list field="data.src_ip" lookup="address_match_key">etc/lists/misp-ip</list>
    <description>MISP IOC: trafic de la IP din threat-intel ($(data.src_ip))</description>
    <group>ids,</group>
  </rule>
  <rule id="100232" level="9">
    <if_group>sshd</if_group>
    <list field="srcip" lookup="address_match_key">etc/lists/misp-ip</list>
    <description>MISP IOC: SSH implicand IP din threat-intel ($(srcip))</description>
    <group>authentication,</group>
  </rule>
  <rule id="100240" level="9">
    <if_sid>100200</if_sid>
    <field name="data.alert.signature">CYBER3 MISP IOC</field>
    <description>MISP IOC: domeniu din threat-intel detectat ($(data.alert.signature))</description>
    <group>ids,</group>
  </rule>

</group>
<!-- CYBER3 → SOC: reguli pentru evenimentele EDR/XDR de la endpoint-uri (Faza 3).
     ALERT-ONLY: toate ≤ level 9 (sub pragul active-response level≥10) + fără srcip → nicio
     auto-blocare. Se adaugă în /var/ossec/etc/rules/local_rules.xml pe manager. Segregare pe $(org). -->
<group name="cyber3,edr,xdr,">

  <!-- Bază: orice eveniment CYBER3 (marcaj c3.app=cyber3, decodat JSON). Fără alertă proprie. -->
  <rule id="100600" level="0">
    <decoded_as>json</decoded_as>
    <field name="c3.app">^cyber3$</field>
    <description>CYBER3 endpoint event</description>
  </rule>

  <!-- Heartbeat: doar prezență, fără alertă. -->
  <rule id="100601" level="0">
    <if_sid>100600</if_sid>
    <field name="c3.type">^heartbeat$</field>
    <description>CYBER3: heartbeat endpoint ($(c3.org))</description>
  </rule>

  <!-- Scanare PC raportată. -->
  <rule id="100602" level="4">
    <if_sid>100600</if_sid>
    <field name="c3.type">^pc_scan$</field>
    <description>CYBER3: scanare PC raportata (org: $(c3.org), dispozitiv: $(c3.device_id))</description>
  </rule>
  <!-- Malware găsit pe endpoint (c3.data.malware_found > 0). -->
  <rule id="100603" level="9">
    <if_sid>100602</if_sid>
    <field name="c3.data.malware_found" type="pcre2">[1-9]</field>
    <description>CYBER3: MALWARE gasit pe endpoint (org: $(c3.org), dispozitiv: $(c3.device_id))</description>
  </rule>

  <!-- Amenințare detectată (scam/link/număr periculos). -->
  <rule id="100604" level="9">
    <if_sid>100600</if_sid>
    <field name="c3.type">^threat$</field>
    <description>CYBER3: amenintare detectata pe endpoint (org: $(c3.org), indicator: $(c3.data.indicator))</description>
  </rule>

  <!-- Email în breșă. -->
  <rule id="100605" level="5">
    <if_sid>100600</if_sid>
    <field name="c3.type">^breach$</field>
    <description>CYBER3: email in bresa (org: $(c3.org))</description>
  </rule>

  <!-- Backup raportat + backup eșuat. -->
  <rule id="100606" level="3">
    <if_sid>100600</if_sid>
    <field name="c3.type">^backup$</field>
    <description>CYBER3: stare backup raportata (org: $(c3.org))</description>
  </rule>
  <rule id="100607" level="6">
    <if_sid>100606</if_sid>
    <field name="c3.data.status" type="pcre2">fail</field>
    <description>CYBER3: BACKUP ESUAT pe endpoint (org: $(c3.org), dispozitiv: $(c3.device_id))</description>
  </rule>

  <!-- anre (icisoc110): reconectare periodica benigna ~3h (plafon sesiune FortiGate ANRE/ISP) - suprimat. Vezi anre-sensor-migration -->
  <rule id="100290" level="0">
    <if_sid>503</if_sid>
    <match>Agent started: 'anre</match>
    <description>anre: reconectare periodica benigna - suprimat</description>
  </rule>

</group>


